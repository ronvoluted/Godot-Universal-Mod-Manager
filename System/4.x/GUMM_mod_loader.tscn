[gd_scene load_steps=2 format=3 uid="uid://cdmfy6r6ayvyf"]

[sub_resource type="GDScript" id="1"]
script/source = "extends Node

var loaded_mods = []

func _ready():
	var mod_list = ProjectSettings.get_setting(\"gumm/mod_list\")
	for mod in mod_list:
		await load_mod(mod)

	get_tree().set_meta(\"GUMM_mods\", loaded_mods)

	var main_scene: String = ProjectSettings.get_setting(\"gumm/main_scene\")
	ResourceLoader.load_threaded_request(main_scene)
	var scene := await _poll_threaded_load(main_scene)
	if scene:
		get_tree().change_scene_to_packed(scene)
	else:
		push_error(\"GUMM: Failed to load main scene: %s\" % main_scene)
		get_tree().change_scene_to_file(main_scene)

func load_mod(mod_path: String):
	var mod_cfg := ConfigFile.new()
	mod_cfg.load(mod_path.path_join(\"mod.cfg\"))
	print(\"Loading mod: \", mod_cfg.get_value(\"Godot Mod\", \"name\", \"[unknown]\"))

	var script_path := mod_path.path_join(\"mod.gd\")
	ResourceLoader.load_threaded_request(script_path)
	var script: GDScript = await _poll_threaded_load(script_path)
	if not script:
		push_error(\"GUMM: Failed to load mod script: %s\" % script_path)
		return

	var mod_ref: RefCounted = script.new()
	mod_ref.initialize(mod_path, get_tree())
	loaded_mods.append(mod_ref)

func _poll_threaded_load(path: String) -> Resource:
	while true:
		var status := ResourceLoader.load_threaded_get_status(path)
		match status:
			ResourceLoader.THREAD_LOAD_IN_PROGRESS:
				await get_tree().process_frame
			ResourceLoader.THREAD_LOAD_LOADED:
				return ResourceLoader.load_threaded_get(path)
			_:
				return null
	return null
"

